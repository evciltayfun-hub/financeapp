# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (Railway) — SQLite on a mounted volume
# DATABASE_URL="file:/app/data/dev.db"

# Site password. When unset (local dev) the login gate is disabled.
# APP_PASSWORD="change-me"

# Secret for POST /api/admin/import (used by scripts/push-to-railway.js)
# IMPORT_SECRET="change-me"
